{
  "name": "@agent-tool-platform/agent-kit",
  "version": "0.0.0-development",
  "description": "Host-neutral agent builds, preparation, Agent Instance records, readiness planning, and host adapters.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/ashergarland/agent-tool-platform/tree/main/packages/agent-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-platform.git",
    "directory": "packages/agent-kit"
  },
  "bugs": {
    "url": "https://github.com/ashergarland/agent-tool-platform/issues"
  },
  "keywords": [
    "agent-tools",
    "agent-composition",
    "capability-registry",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-tool-platform/capability-registry": "0.0.0-development",
    "@agent-tool-platform/runtime": "0.0.0-development",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
