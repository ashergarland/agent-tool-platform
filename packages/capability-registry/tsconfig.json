{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@agent-tool-platform/runtime": ["../runtime/src/index.ts"],
      "@agent-tool-platform/runtime/*": ["../runtime/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
