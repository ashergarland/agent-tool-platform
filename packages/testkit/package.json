{
  "name": "@agent-tool-platform/testkit",
  "version": "0.1.0",
  "description": "Reusable conformance helpers that prove a capability satisfies the agent tool platform contracts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/ashergarland/agent-tool-platform/tree/main/packages/testkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-platform.git",
    "directory": "packages/testkit"
  },
  "bugs": {
    "url": "https://github.com/ashergarland/agent-tool-platform/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-tools",
    "tool-server",
    "conformance",
    "testing"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./root-boundary": {
      "types": "./dist/root-boundary.d.ts",
      "import": "./dist/root-boundary.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./transport-parity": {
      "types": "./dist/transport-parity.d.ts",
      "import": "./dist/transport-parity.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-tool-platform/runtime": "0.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
