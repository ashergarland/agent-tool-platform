{
  "name": "agent-tool-platform",
  "version": "0.1.0",
  "description": "Shared runtime, testkit, and infrastructure primitives for hosted agent tool servers.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:emit": "tsx scripts/emit-openapi.ts openapi.fixture.json",
    "metadata:validate": "tsx scripts/validate-metadata.ts",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-platform.git"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "js-yaml": "4.3.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
